[Unit]
Description=RAG benchmark result notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=benchmark-notifier
Group=benchmark
WorkingDirectory=/logibot/benchmarking-rags-dataset
EnvironmentFile=/logibot/benchmarking-rags-dataset/.env
ExecStart=/logibot/benchmarking-rags-dataset/.venv/bin/python -m app.services.entrypoint telegram --from-environment
Restart=on-failure
RestartSec=30
StateDirectory=benchmark-notifier
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/benchmark-notifier

InaccessiblePaths=/logibot/benchmarking-rags-dataset/.env

[Install]
WantedBy=multi-user.target
