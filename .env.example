# Provider used for generation, agents and RAGAS evaluation: openrouter or openai
LLM_PROVIDER=openrouter

# OpenRouter (default)
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
# Keep this below the remaining provider credit limit.
LLM_MAX_TOKENS=4096
OPENROUTER_HTTP_REFERER=https://github.com/RSPLE/benchmarking-rags-dataset
OPENROUTER_APP_TITLE=Benchmarking RAGs Dataset

# Embeddings can use a provider independently from the LLM.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Direct OpenAI alternative (used when a provider above is set to openai)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REASONING_EFFORT=medium

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=benchmarking-rags-dataset

# Required only by knowledge-enhanced-rag
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
