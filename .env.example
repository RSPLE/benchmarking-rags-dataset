LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-your_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2

EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# -> config funcional para todos os rags, com exceção do graph-rag
LLM_MAX_TOKENS=2048
RAGAS_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=600
RAGAS_TIMEOUT_SECONDS=600
RAGAS_MAX_WORKERS=2

# -> variáveis para testar o graph-rag e pode ser uma boa para o hybrid-rag
# LLM_MAX_TOKENS=2048
# RAGAS_MAX_TOKENS=8192
# LLM_TIMEOUT_SECONDS=900
# RAGAS_TIMEOUT_SECONDS=900
# RAGAS_MAX_WORKERS=1

OPENROUTER_HTTP_REFERER=https://github.com/RSPLE/benchmarking-rags-dataset
OPENROUTER_APP_TITLE=Benchmarking RAGs Dataset

LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=benchmarking-rags-dataset

NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Direct OpenAI alternative (used when a provider above is set to openai)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-5.5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_REASONING_EFFORT=medium
