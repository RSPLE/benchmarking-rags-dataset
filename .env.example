LLM_PROVIDER=openrouter
OPENROUTER_HTTP_REFERER=https://github.com/RSPLE/benchmarking-rags-dataset

OPENROUTER_APP_TITLE="Benchmarking RAGs Dataset"

OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_JUDGE_MODEL=
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=600

RAGAS_MAX_TOKENS=4096
RAGAS_TIMEOUT_SECONDS=600
RAGAS_MAX_WORKERS=1
RAGAS_MAX_ATTEMPTS=1
RAGAS_DO_NOT_TRACK=true

BENCHMARK_HTTP_ATTEMPTS=3
BENCHMARK_RETRY_MAX_WAIT_SECONDS=60
BENCHMARK_MAX_CALLS=200
BENCHMARK_MAX_QUESTION_CALLS=60
BENCHMARK_MAX_TOKENS=1000000
BENCHMARK_MAX_QUESTION_TOKENS=100000
BENCHMARK_MAX_PREPARATION_CALLS=100
BENCHMARK_MAX_SECONDS=3600
BENCHMARK_QUESTION_TIMEOUT_SECONDS=900
BENCHMARK_AGENT_RECURSION_LIMIT=12
BENCHMARK_SELECTION=unresolved
BENCHMARK_REPETITION=1
BENCHMARK_KG_MODE=required
BENCHMARK_CONTEXT_MAX_BYTES=32000
BENCHMARK_INPUT_MAX_BYTES=128000
BENCHMARK_MAX_STAGE_ATTEMPTS=3
BENCHMARK_RETRY_COOLDOWN_SECONDS=60
BENCHMARK_RECONCILE_ON_START=false
BENCHMARK_CREDIT_SCOPE=all
BENCHMARK_ALLOW_KG_REBUILD=false
BENCHMARK_MODE=full
BENCHMARK_OUTPUT_DIR=resultados
BENCHMARK_BUDGET_DIR=resultados
BENCHMARK_REMOTE_ENABLED=false

LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=benchmarking-rags-dataset

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_RESULTS_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_PROGRESS_INTERVAL_SECONDS=15
TELEGRAM_SEND_FINAL_FILES=true
BENCHMARK_CONTROL_SOCKET=/run/benchmark/control.sock
BENCHMARK_CONTROL_DATABASE=/var/lib/benchmark/control/queue.db
BENCHMARK_TELEGRAM_DATABASE=/var/lib/benchmark-notifier/telegram.outbox.db
