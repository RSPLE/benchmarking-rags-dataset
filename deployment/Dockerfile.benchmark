FROM ghcr.io/astral-sh/uv:0.12.5 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_NO_SYNC=1 PYTHONUNBUFFERED=1 PYTHON_DOTENV_DISABLED=1 UV_CACHE_DIR=/tmp/uv-cache
WORKDIR /app
COPY pyproject.toml uv.lock /app/
COPY rags /app/rags
RUN uv sync --frozen --no-dev --python /usr/local/bin/python && for project in rags/*; do uv sync --project "$project" --frozen --python /usr/local/bin/python; done
COPY *.py /app/
COPY eval-dataset/*.json /app/eval-dataset/
COPY data /app/data
RUN groupadd --gid 1000 benchmark && useradd --uid 1000 --gid 1000 --create-home benchmark && mkdir -p /state /run/benchmark /app/resultados && chown benchmark:benchmark /state /run/benchmark /app/resultados && for project in /app/rags/*; do mkdir -p "$project/chroma_v2"; chown benchmark:benchmark "$project/chroma_v2"; done
USER benchmark
ENV PATH=/app/.venv/bin:$PATH
CMD ["python", "service_entrypoint.py", "control", "--from-environment"]
