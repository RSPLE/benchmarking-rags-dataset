[Unit]
Description=Bounded RAG benchmark batch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=benchmark
Group=benchmark
WorkingDirectory=/logibot/benchmarking-rags-dataset
Environment=UV_CACHE_DIR=/var/lib/benchmark/uv-cache
EnvironmentFile=/logibot/benchmarking-rags-dataset/.env
ExecStart=/logibot/benchmarking-rags-dataset/.venv/bin/python -m app.services.entrypoint batch --from-environment
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=960
KillSignal=SIGTERM
KillMode=control-group
StateDirectory=benchmark
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

InaccessiblePaths=/logibot/benchmarking-rags-dataset/.env

[Install]
WantedBy=multi-user.target
