[Unit]
Description=RAG benchmark result notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=benchmark-notifier
Group=benchmark
WorkingDirectory=/logibot/benchmarking-rags-dataset
EnvironmentFile=/etc/benchmark/telegram.env
ExecStart=/usr/bin/python3 telegram_notifier.py /logibot/benchmarking-rags-dataset/resultados --database /var/lib/benchmark-notifier/telegram.outbox.db
Restart=on-failure
RestartSec=30
StateDirectory=benchmark-notifier
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/benchmark-notifier
InaccessiblePaths=/logibot/benchmarking-rags-dataset/.env /etc/benchmark/worker.env

[Install]
WantedBy=multi-user.target
